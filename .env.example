# Bắt buộc
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=rc.raw
PG_DSN=postgresql://wiki:wiki@postgres:5432/wiki
DELTA_ROOT=/data/delta
# Wikimedia yêu cầu liên hệ thật. KHÔNG giả dạng User-Agent trình duyệt.
WIKI_CONTACT=nhom6.bigdata@example.com

# Tùy chọn (giá trị dưới đây là mặc định)
WIKIS=enwiki
KAFKA_PARTITIONS=3
DIFF_MAX_RPS=10
DIFF_MAX_CHARS=10000
WATERMARK_MINUTES=10
LABEL_CUTOFF_MINUTES=60
LATE_RECHECK_HOURS=24
RISK_QUEUE_SIZE=50
SUMMARY_MODE=template
SALT_PATH=state/salt.txt
STATE_PATH=state
DATA_DIR=data
CHECKPOINT_ROOT=state/checkpoints
