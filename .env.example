# Bắt buộc
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=rc.raw
PG_DSN=postgresql://wiki:wiki@postgres:5432/wiki
DELTA_ROOT=/data/delta
# Wikimedia yêu cầu liên hệ thật. KHÔNG giả dạng User-Agent trình duyệt.
WIKI_CONTACT=nhom6.bigdata@example.com

# Tùy chọn (giá trị dưới đây là mặc định)
WIKIS=enwiki
KAFKA_PARTITIONS=3
DIFF_MAX_RPS=10
DIFF_MAX_CHARS=10000
WATERMARK_MINUTES=10
LABEL_CUTOFF_MINUTES=60
LATE_RECHECK_HOURS=24
RISK_QUEUE_SIZE=50
SUMMARY_MODE=template
SALT_PATH=state/salt.txt
STATE_PATH=state
DATA_DIR=data
# Trong container spark, docker-compose.yml ghi đè: DELTA_ROOT=/data/delta,
# CHECKPOINT_ROOT=/state/checkpoints (thư mục /app chỉ đọc).
CHECKPOINT_ROOT=state/checkpoints

# Chat hỏi đáp (tuỳ chọn). Không có key thì chat chuyển sang gợi ý 5 câu bấm sẵn.
# Mỗi câu hỏi gọi API và tốn tiền; tối đa 20 câu/phút cho toàn hệ thống.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
